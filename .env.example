# --- Local PostgreSQL ---
# Create role + DB first: npm run db:setup
DATABASE_URL="postgresql://orderline:orderline@localhost:5432/orderline?schema=public"

# --- Production (Vercel + Neon / Prisma Postgres / Supabase) ---
# Use the pooled connection string when the host provides one.
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Local:
AUTH_URL="http://localhost:3000"
# Production (your Vercel domain):
# AUTH_URL="https://your-app.vercel.app"

# App
NEXT_PUBLIC_APP_NAME="OrderLine"
# Used for sitemap, robots, canonical, Open Graph absolute URLs
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional — Super Admin (defaults to demo@orderline.app when seeding)
# SUPER_ADMIN_EMAIL="demo@orderline.app"

# Optional — WhatsApp / AI (not required for basic site launch)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# WHATSAPP_ENCRYPTION_KEY=
# META_APP_ID=
# META_APP_SECRET=
# META_WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PUBLIC_URL=
