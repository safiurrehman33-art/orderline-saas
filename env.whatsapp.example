# WhatsApp / Meta Cloud API (Step 2)
# Copy these into your local .env (do not commit secrets).

# Local login must stay on localhost (avoid redirect loops)
AUTH_URL=http://localhost:3000
# Public HTTPS base for Meta webhooks (ngrok in dev, real domain in prod)
WHATSAPP_PUBLIC_URL=https://your-ngrok-or-domain.example
# Prefer a dedicated key; AUTH_SECRET works as fallback for encryption
WHATSAPP_ENCRYPTION_KEY=replace-with-long-random-string

# Meta Developer App
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v21.0
META_WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token

# Browser-safe duplicates for Embedded Signup button
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_API_VERSION=v21.0

# Meta App → WhatsApp → Configuration → Callback URL:
#   {WHATSAPP_PUBLIC_URL}/api/whatsapp/webhook
# Verify token must match META_WHATSAPP_VERIFY_TOKEN
# Subscribe webhook fields: messages

# Step 3 — Real AI agent (required for smart WhatsApp replies)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
