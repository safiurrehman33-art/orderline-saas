// OrderLine SaaS — restaurant POS + multi-tenant ops
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  READY
  FULFILLED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum TableShape {
  ROUND
  SQUARE
  RECT
  CLOUD
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

enum WhatsAppBotMode {
  OFF
  ACTIVE
  PAUSED
}

enum WhatsAppConversationStatus {
  OPEN
  BOT
  HUMAN
  CLOSED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppMessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM
  HUMAN
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

enum CmsPageTemplate {
  DEFAULT
  HOME
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  /// Smart Pricing
  taxEnabled            Boolean @default(false)
  salesTaxPercent       Float   @default(0)
  vatPercent            Float   @default(0)
  serviceChargePercent  Float   @default(0)
  pricesIncludeTax      Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  customers   Customer[]
  products    Product[]
  categories  Category[]
  deals       Deal[]
  tables      DiningTable[]
  orders      Order[]
  invites     OrganizationInvite[]
  auditLogs   AuditLog[]
  whatsappConnection WhatsAppConnection?
  whatsappChatbot    WhatsAppChatbotConfig?
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  /// Platform-level Super Admin (CMS / marketing site)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
  invitesSent OrganizationInvite[] @relation("InviteSender")
  auditLogs   AuditLog[]
  passwordResets PasswordResetToken[]
}

/// Marketing / public website pages (managed by Super Admin)
model CmsPage {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  excerpt          String?
  /// Rich HTML body (About, Privacy, custom pages)
  contentHtml      String          @default("") @db.Text
  /// Structured home page blocks (hero, features, showcase, CTA)
  homeBlocks       Json?
  template         CmsPageTemplate @default(DEFAULT)
  status           CmsPageStatus   @default(DRAFT)
  /// System pages cannot change slug / be deleted
  isSystem         Boolean         @default(false)
  /// SEO
  metaTitle        String?
  metaDescription  String?         @db.Text
  metaKeywords     String?
  ogImage          String?
  canonicalPath    String?
  noIndex          Boolean         @default(false)
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  navItems CmsNavItem[]

  @@index([status])
  @@index([template])
}

model CmsNavItem {
  id           String   @id @default(cuid())
  label        String
  href         String
  sortOrder    Int      @default(0)
  visible      Boolean  @default(true)
  openInNewTab Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pageId String?
  page   CmsPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([sortOrder])
  @@index([visible])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entityType     String
  entityId       String?
  summary        String
  metadata       Json?
  actorEmail     String?
  actorName      String?
  createdAt      DateTime @default(now())

  organizationId String?
  actorId        String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userId         String
  organizationId String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationInvite {
  id             String         @id @default(cuid())
  email          String
  role           MembershipRole @default(MEMBER)
  token          String         @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())

  organizationId String
  invitedById    String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User           @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
}

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?
  imageUrl       String?
  color          String   @default("#0f6b4c")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
  @@index([organizationId, active])
}

model DiningTable {
  id             String      @id @default(cuid())
  name           String
  code           String
  seats          Int         @default(4)
  status         TableStatus @default(AVAILABLE)
  section        String?
  shape          TableShape  @default(CLOUD)
  posX           Float       @default(80)
  posY           Float       @default(80)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, section])
  @@index([organizationId, sortOrder])
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?   @default("US")
  notes          String?   @db.Text
  tags           String[]  @default([])
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  whatsappConversations WhatsAppConversation[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, archivedAt])
  @@index([organizationId, name])
}

model Product {
  id             String    @id @default(cuid())
  name           String
  sku            String
  description    String?   @db.Text
  imageUrl       String?
  priceCents     Int
  costCents      Int?
  currency       String    @default("USD")
  stockQty       Int       @default(0)
  trackStock     Boolean   @default(false)
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String
  categoryId     String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  dealItems      DealItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, active])
  @@index([categoryId])
  @@index([organizationId, archivedAt])
}

model Deal {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?  @db.Text
  imageUrl       String?
  priceCents     Int
  compareAtCents Int?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          DealItem[]

  @@unique([organizationId, slug])
  @@index([organizationId, active])
  @@index([organizationId, sortOrder])
}

model DealItem {
  id        String @id @default(cuid())
  quantity  Int    @default(1)

  dealId    String
  productId String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dealId, productId])
  @@index([productId])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String
  status         OrderStatus @default(DRAFT)
  orderType      OrderType   @default(TAKEAWAY)
  guestCount     Int         @default(1)
  notes          String?     @db.Text
  subtotalCents  Int         @default(0)
  salesTaxCents  Int         @default(0)
  vatCents       Int         @default(0)
  serviceCents   Int         @default(0)
  taxCents       Int         @default(0)
  totalCents     Int         @default(0)
  currency       String      @default("USD")
  placedAt       DateTime?
  fulfilledAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organizationId String
  customerId     String?
  tableId        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table          DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusEvents   OrderStatusEvent[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, orderType])
  @@index([customerId])
  @@index([tableId])
}

model OrderItem {
  id          String  @id @default(cuid())
  quantity    Int
  unitCents   Int
  totalCents  Int
  productName String
  productSku  String

  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
  createdBy  String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// One WhatsApp Business number per organization (Meta Cloud API).
model WhatsAppConnection {
  id             String                   @id @default(cuid())
  status         WhatsAppConnectionStatus @default(DISCONNECTED)
  /// Meta Cloud API phone_number_id
  phoneNumberId  String?                  @unique
  /// WhatsApp Business Account id
  wabaId         String?
  /// E.164 display number e.g. +923001234567
  displayPhoneNumber String?
  verifiedName   String?
  metaBusinessId String?
  /// AES-GCM encrypted access token (never store plaintext)
  accessTokenEnc String?                  @db.Text
  tokenExpiresAt DateTime?
  /// SHA-256 hash of webhook verify token
  webhookVerifyTokenHash String?
  lastError      String?                  @db.Text
  connectedAt    DateTime?
  lastWebhookAt  DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chatbot        WhatsAppChatbotConfig?
  conversations  WhatsAppConversation[]

  @@index([status])
  @@index([displayPhoneNumber])
}

/// Per-org AI chatbot behaviour — advanced, simple toggles.
model WhatsAppChatbotConfig {
  id             String         @id @default(cuid())
  mode           WhatsAppBotMode @default(OFF)
  displayName    String         @default("OrderLine Assistant")
  greetingMessage String        @db.Text @default("Hi! Welcome to our restaurant. I can help with the menu, deals, and placing an order.")
  fallbackMessage String        @db.Text @default("Sorry — I didn’t catch that. You can ask about the menu, deals, or type *agent* to talk to our team.")
  language       String         @default("en")
  tone           String         @default("friendly")

  canBrowseMenu   Boolean @default(true)
  canTakeOrders   Boolean @default(true)
  canTrackOrders  Boolean @default(true)
  canAnswerFaq    Boolean @default(true)
  allowDelivery   Boolean @default(true)
  allowTakeaway   Boolean @default(true)
  allowDineIn     Boolean @default(false)

  businessHoursEnabled Boolean @default(false)
  /// Simple weekly hours JSON, e.g. { "mon":[["10:00","22:00"]], ... }
  businessHoursJson    Json?
  offlineMessage       String? @db.Text

  humanHandoffEnabled Boolean  @default(true)
  handoffKeywords     String[] @default(["agent", "human", "staff", "help"])

  /// Extra owner instructions injected into the AI system prompt
  systemPromptExtra String? @db.Text
  maxReplyTokens    Int     @default(800)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String       @unique
  connectionId   String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection     WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([mode])
}

model WhatsAppConversation {
  id                    String                     @id @default(cuid())
  /// Meta WhatsApp user id (usually phone without +)
  customerWaId          String
  customerName          String?
  customerPhone         String?
  status                WhatsAppConversationStatus @default(OPEN)
  botPaused             Boolean                    @default(false)
  lastMessageAt         DateTime?
  lastCustomerMessageAt DateTime?
  unreadCount           Int                        @default(0)
  metadata              Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  organizationId String
  connectionId   String
  customerId     String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection     WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages       WhatsAppMessage[]

  @@unique([connectionId, customerWaId])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, status])
  @@index([customerId])
}

model WhatsAppMessage {
  id           String                   @id @default(cuid())
  direction    WhatsAppMessageDirection
  role         WhatsAppMessageRole
  status       WhatsAppMessageStatus    @default(RECEIVED)
  /// Meta wamid
  waMessageId  String?                  @unique
  body         String?                  @db.Text
  mediaType    String?
  mediaUrl     String?
  /// Raw Meta payload / tool-call traces (for debugging + AI memory)
  payload      Json?
  error        String?
  createdAt    DateTime                 @default(now())

  organizationId String
  conversationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status])
}
